# Copy to .env.prod.local (git-ignored) and fill in. Used by docker-compose.prod.yaml.

# compose
APP_IMAGE=cms-admin
APP_TAG=latest
# published port of the standalone stack; on the VPS the Traefik override removes it
HTTP_PORT=80
# public domain, used by the server-side docker-compose.traefik.yaml router rule
CMS_DOMAIN=example.com
# run doctrine migrations when php-fpm starts (1/0)
RUN_MIGRATIONS=1

# database (the mysql service is created with these credentials on first start)
MYSQL_DATABASE=cms_admin
MYSQL_USER=cms_admin
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!ChangeMe!

# application
APP_SECRET=!ChangeMe!
TIMEZONE=UTC
# host of the admin routes (/admin); must equal CMS_DOMAIN
ADMIN_DOMAIN=example.com
DEFAULT_URI=https://example.com/
DEFAULT_LOCALE=en_GB
LOCALES=["en_GB","uk_UA","ru_UA"]
# one domain: /admin and /api share the origin of the site
CORS_ALLOW_ORIGIN=^https://example\.com$
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# site API (JWT); the key files live in the "jwt" volume, generate them once:
#   docker compose -f docker-compose.prod.yaml --env-file .env.prod.local exec php-fpm bin/console lexik:jwt:generate-keypair
JWT_PASSPHRASE=!ChangeMe!
JWT_TOKEN_TTL=3600
